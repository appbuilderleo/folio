# CockroachDB / PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full
PORT=3001
# Groq API key for batch ½-paragraph summaries (admin ingestion)
GROQ_API_KEY=
# Optional Groq model override (default: openai/gpt-oss-20b)
GROQ_MODEL=
# Initial Admin account bootstrapped automatically in CockroachDB (isolated /admin panel)
ADMIN_EMAIL=admin@folio.co.mz
ADMIN_PASSWORD=trocar-por-senha-forte
# SEO & Discovery (optional overrides — defaults to https://folio-one-snowy.vercel.app)
SITE_URL=https://folio-one-snowy.vercel.app
VITE_SITE_URL=https://folio-one-snowy.vercel.app
# Optional IndexNow key (8–128 alphanumeric/hyphen chars) for instant Bing/IndexNow notifications on publish
INDEXNOW_KEY=
