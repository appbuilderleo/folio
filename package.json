{
  "name": "folio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fólio — Motor de busca curricular e leitor didático offline para Moçambique (1.ª à 12.ª classe).",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,yellow \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "db:init": "tsx server/initDb.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "lucide-react": "^1.76.0",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/pg": "^8.11.13",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^8.3.8"
  }
}